{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/blob/main/docs/release/k4c-manifest-validation-schema-v1.json",
  "title": "K4C Codex plugin manifest validation receipt",
  "description": "Deterministic local evidence that the repository generator and the version-recorded @plugin-creator adapter accepted one generated skills-only package. Publication is outside this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageVersion",
    "packagePath",
    "packageDigest",
    "manifest",
    "canonicalVerification",
    "pluginCreatorVerification",
    "publicationPerformed",
    "dryRun",
    "accepted",
    "nonClaims"
  ],
  "properties": {
    "schemaVersion": { "const": "kaleidosphere/k4c-manifest-validation-receipt/v1" },
    "packageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "packagePath": { "type": "string", "minLength": 1 },
    "packageDigest": { "$ref": "#/$defs/sha256" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": ".codex-plugin/plugin.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "canonicalVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "status", "generator", "fixture", "receiptSchemaVersion"],
      "properties": {
        "route": { "const": "repository-generator" },
        "status": { "const": "passed" },
        "generator": { "const": "scripts/release/generate-k4c-codex-plugin.mjs" },
        "fixture": { "const": "tests/fixtures/release/k4c-canonical-skill-digests-v1.json" },
        "receiptSchemaVersion": { "const": "kaleidosphere/k4c-codex-plugin-receipt/v1" }
      }
    },
    "pluginCreatorVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "toolVersion", "validatorPath", "validatorSha256", "transcript"],
      "properties": {
        "adapter": { "const": "@plugin-creator" },
        "toolVersion": { "type": "string", "minLength": 1 },
        "validatorPath": { "type": "string", "minLength": 1 },
        "validatorSha256": { "$ref": "#/$defs/sha256" },
        "transcript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "exitCode", "stdout", "stderr"],
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "exitCode": { "const": 0 },
            "stdout": { "type": "string" },
            "stderr": { "const": "" }
          }
        }
      }
    },
    "publicationPerformed": { "const": false },
    "dryRun": { "type": "boolean" },
    "accepted": { "const": true },
    "nonClaims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
