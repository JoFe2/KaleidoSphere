{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/blob/main/docs/release/k4c-codex-e2e-schema-v1.json",
  "title": "K4C isolated Codex CLI E2E receipt",
  "description": "Receipt for a local, clean-boundary Codex plugin install/discovery/use/denial/removal/readback, or its deterministic transcript fixture equivalent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "codex", "package", "boundaryProof", "orderedCommandResults", "negativeAssertions", "accepted", "globalConfigurationMutated", "nonClaims"],
  "properties": {
    "schemaVersion": {"const": "kaleidosphere/k4c-codex-isolated-e2e/v1"},
    "mode": {"enum": ["fixture", "clean-boundary"]},
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "version", "versionCommand"],
      "properties": {
        "binary": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "versionCommand": {"$ref": "#/$defs/command"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "packageDigest", "manifestSha256", "pluginName", "marketplaceName", "skillPath", "expectedUseResponse"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "packageDigest": {"$ref": "#/$defs/sha256"},
        "manifestSha256": {"$ref": "#/$defs/sha256"},
        "pluginName": {"type": "string", "minLength": 1},
        "marketplaceName": {"type": "string", "minLength": 1},
        "skillPath": {"type": "string", "const": "skills/kaleidosphere/SKILL.md"},
        "expectedUseResponse": {"type": "string", "minLength": 1},
        "deniedUseResponse": {"type": "string", "minLength": 1},
        "generatedPackageReceipt": {"type": ["object", "null"]}
      }
    },
    "boundaryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "globalConfigurationMutated", "residuePaths", "emptyAfterCleanup"],
      "properties": {
        "clean": {"type": "boolean"},
        "globalConfigurationMutated": {"const": false},
        "profileRoot": {"type": "string"},
        "packageRoot": {"type": "string"},
        "configRoots": {"type": "array", "items": {"type": "string"}},
        "cacheRoots": {"type": "array", "items": {"type": "string"}},
        "residuePaths": {"type": "array", "items": {"type": "string"}},
        "emptyAfterCleanup": {"type": "boolean"},
        "temporaryBoundaryDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "orderedCommandResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "phase", "command", "expectedOutcome", "result"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "id": {"type": "string", "minLength": 1},
          "phase": {"type": "string", "minLength": 1},
          "command": {"$ref": "#/$defs/command"},
          "expectedOutcome": {"enum": ["passed", "denied"]},
          "assertion": {"type": "string", "minLength": 1},
          "result": {"$ref": "#/$defs/result"}
        }
      }
    },
    "negativeAssertions": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "required", "observed"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"const": true},
          "observed": {"const": "denied"}
        }
      }
    },
    "accepted": {"type": "boolean"},
    "globalConfigurationMutated": {"const": false},
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "failure": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exitCode", "signal", "stdout", "stderr"],
      "properties": {
        "exitCode": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"]},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "errorCode": {"type": ["string", "null"]}
      }
    }
  }
}
