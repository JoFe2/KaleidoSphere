{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/blob/main/docs/release/k4c-portal-submission-contract-v1.json",
  "title": "K4C local portal-submission preflight receipt",
  "description": "Offline, one-shot contract for validating same-digest security evidence and reviewer packet inputs. No portal operation is represented as completed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixture", "fixtureSha256", "validatedInputDigests", "portal", "disposition", "redactedReason", "evidence", "side_effects", "resumeActions", "proposal", "nonClaims"],
  "properties": {
    "schemaVersion": {"const": "kaleidosphere/k4c-portal-submission-receipt/v1"},
    "fixture": {"type": "string", "minLength": 1},
    "fixtureSha256": {"$ref": "#/$defs/sha256"},
    "validatedInputDigests": {"$ref": "#/$defs/inputDigests"},
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identityClass", "capability"],
      "properties": {
        "identityClass": {"type": ["string", "null"]},
        "capability": {"type": ["string", "null"]}
      }
    },
    "disposition": {"enum": ["PRECHECK_READY", "NOT_SUBMITTED", "REJECTED_WITH_EVIDENCE"]},
    "redactedReason": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "redactedReason"],
        "properties": {"code": {"type": "string", "minLength": 1}, "redactedReason": {"type": "string", "minLength": 1}}
      }
    },
    "side_effects": {"const": []},
    "resumeActions": {
      "type": "array",
      "maxItems": 1,
      "items": {"type": "string", "const": "Owner resumes in the official portal UI to verify owner authority and publisher identity."}
    },
    "proposal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "packageDigest", "portalIdentityClass", "packetDigest", "redactedReason"],
      "properties": {
        "kind": {"const": "non-executable"},
        "packageDigest": {"$ref": "#/$defs/sha256"},
        "portalIdentityClass": {"const": "owner-official-ui"},
        "packetDigest": {"$ref": "#/$defs/sha256"},
        "redactedReason": {"type": "string", "minLength": 1}
      }
    },
    "nonClaims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "digestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expectedSha256", "observedSha256"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "expectedSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "observedSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "inputDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "securityReceipt", "reviewerPacket"],
      "properties": {
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "digest", "manifestSha256"],
          "properties": {
            "version": {"type": ["string", "null"]},
            "digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
            "manifestSha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "securityReceipt": {"$ref": "#/$defs/digestRef"},
        "reviewerPacket": {"$ref": "#/$defs/digestRef"}
      }
    }
  }
}
