  "assumptions": [
    {
      "id": "assumption-residency-choice-is-explicit",
      "domain": "residency",
      "statement": "A future candidate will select one named residency choice before handling and bind it to an allowed tenant boundary.",
      "scope": ["tenant boundary", "data handling", "future candidate review"],
      "evidenceNeeded": ["synthetic residency choice", "synthetic tenant-boundary mapping", "residency review record"],
      "decisionAuthority": "synthetic-data-governance",
      "expiryReview": {
        "reviewOwner": "synthetic-data-governance",
        "reviewTrigger": "before any future contract version or jurisdiction change",
        "expiryCondition": "residency evidence or tenant mapping is stale",
        "expiryOutcome": "REJECT_AND_REVIEW"
      },
      "impact": "Without this assumption being evidenced, the candidate cannot be admitted or remapped to another region.",
      "gate": "gate-residency-selection",
      "status": "UNVERIFIED_PLANNING_ASSUMPTION"
    },
    {
      "id": "assumption-retention-is-finite-and-verifiable",
      "domain": "retention",
      "statement": "A future candidate will use a finite, triggered retention period and verify deletion rather than rely on indefinite storage.",
      "scope": ["synthetic data categories", "retention policy", "deletion evidence"],
      "evidenceNeeded": ["data classification", "finite duration and trigger", "deletion manifest and digest verification"],
      "decisionAuthority": "synthetic-data-governance",
      "expiryReview": {
        "reviewOwner": "synthetic-data-governance",
        "reviewTrigger": "at each retention-policy revision and before expiry",
        "expiryCondition": "duration, trigger, owner, or deletion verification is missing",
        "expiryOutcome": "REJECT_AND_DELETE"
      },
      "impact": "Missing or unbounded retention prevents approval and requires deletion or rejection evidence.",
      "gate": "gate-retention-deletion",
      "status": "UNVERIFIED_PLANNING_ASSUMPTION"
    },
    {
      "id": "assumption-isolation-is-same-tenant",
      "domain": "isolation",
      "statement": "A future candidate will require matching tenant identity and tenant scope for every permitted flow, with no cross-tenant read, write, export, or bypass.",
      "scope": ["tenant boundary", "control plane", "data plane", "operator review"],
      "evidenceNeeded": ["tenant-scope binding", "flow inventory", "cross-tenant negative cases", "bypass negative case"],
      "decisionAuthority": "synthetic-security-and-data-governance",
      "expiryReview": {
        "reviewOwner": "synthetic-security-and-data-governance",
        "reviewTrigger": "before any boundary, flow, or authorization change",
        "expiryCondition": "a flow or isolation key is added without review evidence",
        "expiryOutcome": "REJECT_AND_REVIEW"
      },
      "impact": "An ambiguous or shared tenant boundary blocks approval and produces a stable isolation denial.",
      "gate": "gate-tenant-isolation",
      "status": "UNVERIFIED_PLANNING_ASSUMPTION"
    },
    {
      "id": "assumption-custody-is-reference-only",
      "domain": "custody",
      "statement": "A future candidate may compare only bounded, non-secret references; plaintext, customer credential capture, and secret exposure remain prohibited.",
      "scope": ["secret custody", "hypothetical access", "logs and artifacts"],
      "evidenceNeeded": ["custody boundary", "one-tenant one-operation scope", "rotation and revocation evidence", "log/artifact exclusion evidence"],
      "decisionAuthority": "synthetic-security-and-operations",
      "expiryReview": {
        "reviewOwner": "synthetic-security-and-operations",
        "reviewTrigger": "before any custody option, access scope, or reference lifetime change",
        "expiryCondition": "rotation, revocation, scope, or exclusion evidence is absent or ambiguous",
        "expiryOutcome": "REJECT_AND_REAUTHORIZE"
      },
      "impact": "The candidate cannot proceed when custody evidence is incomplete; no secret value may enter the fixture, logs, or review record.",
      "gate": "gate-secret-custody",
      "status": "UNVERIFIED_PLANNING_ASSUMPTION"
    },
    {
      "id": "assumption-egress-is-exact-and-deny-default",
      "domain": "egress",
      "statement": "A future candidate will be limited to an exact tenant-scoped logical destination and will not create a real network operation; the default remains deny.",
      "scope": ["egress destination", "tenant scope", "data class", "network boundary"],
      "evidenceNeeded": ["exact candidate entry", "completed approval record", "tenant-scope binding", "no-network-operation evidence"],
      "decisionAuthority": "synthetic-security-and-data-governance",
      "expiryReview": {
        "reviewOwner": "synthetic-security-and-data-governance",
        "reviewTrigger": "before any destination, data class, or network-boundary change",
        "expiryCondition": "destination, scope, approval, or network posture is not exact and current",
        "expiryOutcome": "REJECT_AND_REVIEW"
      },
      "impact": "Uncontrolled, wildcard, cross-tenant, secret, regulated, or real-network egress is denied without retry or remapping.",
      "gate": "gate-egress-allowlist",
      "status": "UNVERIFIED_PLANNING_ASSUMPTION"
    }
  ],
