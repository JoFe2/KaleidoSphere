{
  "schemaVersion": "kaleidosphere.remote-connector/secret-custody-options/v1",
  "matrixId": "KS91-SECRET-CUSTODY-OPTIONS-01",
  "status": "FROZEN_FUTURE_SURFACE",
  "evidenceClass": "synthetic-fixture-only",
  "scope": "planning-candidate-only",
  "policy": {
    "default": "DENY",
    "syntheticOnly": true,
    "liveCustomerDataAllowed": false,
    "customerCredentialCaptureAllowed": false,
    "plaintextCustodyAllowed": false,
    "secretValuesInFixtureAllowed": false,
    "secretValuesInLogsAllowed": false,
    "secretValuesInArtifactsAllowed": false,
    "configuredSecretStore": false,
    "productionUseAllowed": false
  },
  "logArtifactExclusionRule": {
    "rule": "secret values, credential material, private keys, and customer credential input are excluded from logs, test output, artifacts, fixtures, telemetry, and review evidence",
    "excludedSurfaces": [
      "logs",
      "test-output",
      "artifacts",
      "fixtures",
      "telemetry",
      "review-evidence"
    ],
    "permittedEvidence": [
      "synthetic-reference-id",
      "synthetic-scope-label",
      "approval-status",
      "rotation-status",
      "revocation-status",
      "audit-event-digest"
    ],
    "redactionFailureOutcome": "REJECTED_WITH_EVIDENCE"
  },
  "options": [
    {
      "id": "reference-only-brokered-custody",
      "label": "Reference-only brokered custody",
      "custodyBoundary": "synthetic-external-secret-manager-reference",
      "hypotheticalAccess": {
        "principal": "synthetic-control-plane",
        "mode": "one-time-scoped-reference",
        "scope": "one-synthetic-tenant-and-one-operation",
        "secretValueVisibleToConsumer": false,
        "customerCredentialCapture": false
      },
      "rotationRevocation": {
        "rotationAssumption": "synthetic-manager-rotates-reference-before-expiry",
        "revocationAssumption": "synthetic-manager-revokes-reference-on-denial-or-scope-change",
        "maximumReferenceLifetime": "synthetic-short-lived",
        "staleReferenceOutcome": "REJECT_AND_REAUTHORIZE"
      },
      "auditRequirements": {
        "requiredEvents": ["approval", "reference-use", "rotation", "revocation"],
        "recordedFields": ["synthetic-reference-id", "tenant-scope", "decision", "event-time", "event-digest"],
        "secretValueRecorded": false,
        "auditDestination": "synthetic-local-review-ledger"
      },
      "approver": "synthetic-security-and-data-governance",
      "rejectionTrigger": "reject if scope, expiry, revocation state, or audit evidence is absent or ambiguous",
      "approvalGate": {
        "id": "gate-reference-only-brokered",
        "status": "APPROVED_FOR_SYNTHETIC_REVIEW",
        "requiredChecks": ["tenant-scope-bound", "one-time-access", "rotation-defined", "revocation-defined", "audit-defined", "log-artifact-exclusion-verified"],
        "evidence": "synthetic-review-record-reference-only-brokered"
      },
      "decision": "APPROVE_CANDIDATE_ONLY"
    },
    {
      "id": "local-file-reference-custody",
      "label": "Local file reference custody",
      "custodyBoundary": "synthetic-local-mode-0600-secret-file-reference",
      "hypotheticalAccess": {
        "principal": "synthetic-control-process",
        "mode": "local-read-at-operation-boundary",
        "scope": "one-synthetic-tenant-and-one-operation",
        "secretValueVisibleToConsumer": false,
        "customerCredentialCapture": false
      },
      "rotationRevocation": {
        "rotationAssumption": "synthetic-operator-replaces-file-reference-before-review-window",
        "revocationAssumption": "synthetic-operator-removes-reference-and-denies-further-use",
        "maximumReferenceLifetime": "synthetic-review-window",
        "staleReferenceOutcome": "REJECT_AND_REAUTHORIZE"
      },
      "auditRequirements": {
        "requiredEvents": ["approval", "reference-read-attempt", "rotation", "revocation"],
        "recordedFields": ["synthetic-reference-id", "tenant-scope", "decision", "event-time", "event-digest"],
        "secretValueRecorded": false,
        "auditDestination": "synthetic-local-review-ledger"
      },
      "approver": "synthetic-operations-and-data-governance",
      "rejectionTrigger": "reject if file mode, owner boundary, rotation evidence, revocation evidence, or audit evidence is absent",
      "approvalGate": {
        "id": "gate-local-file-reference",
        "status": "APPROVED_FOR_SYNTHETIC_REVIEW",
        "requiredChecks": ["tenant-scope-bound", "mode-0600-assumed", "rotation-defined", "revocation-defined", "audit-defined", "log-artifact-exclusion-verified"],
        "evidence": "synthetic-review-record-local-file-reference"
      },
      "decision": "APPROVE_CANDIDATE_ONLY"
    },
    {
      "id": "ephemeral-session-reference-custody",
      "label": "Ephemeral session reference custody",
      "custodyBoundary": "synthetic-ephemeral-session-reference",
      "hypotheticalAccess": {
        "principal": "synthetic-session-broker",
        "mode": "bounded-session-reference-with-no-export",
        "scope": "one-synthetic-tenant-and-one-approved-operation",
        "secretValueVisibleToConsumer": false,
        "customerCredentialCapture": false
      },
      "rotationRevocation": {
        "rotationAssumption": "synthetic-session-broker-issues-a-new-reference-per-session",
        "revocationAssumption": "synthetic-session-broker-invalidates-session-on-close-or-denial",
        "maximumReferenceLifetime": "synthetic-session-only",
        "staleReferenceOutcome": "REJECT_AND_REAUTHORIZE"
      },
      "auditRequirements": {
        "requiredEvents": ["approval", "session-open", "session-close", "rotation", "revocation"],
        "recordedFields": ["synthetic-reference-id", "tenant-scope", "decision", "event-time", "event-digest"],
        "secretValueRecorded": false,
        "auditDestination": "synthetic-local-review-ledger"
      },
      "approver": "synthetic-security-and-operations",
      "rejectionTrigger": "reject if session scope, expiry, close/revocation evidence, or audit evidence is absent or ambiguous",
      "approvalGate": {
        "id": "gate-ephemeral-session-reference",
        "status": "APPROVED_FOR_SYNTHETIC_REVIEW",
        "requiredChecks": ["tenant-scope-bound", "no-export", "rotation-defined", "revocation-defined", "audit-defined", "log-artifact-exclusion-verified"],
        "evidence": "synthetic-review-record-ephemeral-session-reference"
      },
      "decision": "APPROVE_CANDIDATE_ONLY"
    },
    {
      "id": "plaintext-runtime-custody",
      "label": "Plaintext runtime custody",
      "custodyBoundary": "synthetic-runtime-memory",
      "hypotheticalAccess": {
        "principal": "synthetic-runtime",
        "mode": "plaintext-value",
        "scope": "unbounded",
        "secretValueVisibleToConsumer": true,
        "customerCredentialCapture": false
      },
      "rotationRevocation": {
        "rotationAssumption": "unspecified",
        "revocationAssumption": "unspecified",
        "maximumReferenceLifetime": "unbounded",
        "staleReferenceOutcome": "REJECT"
      },
      "auditRequirements": {
        "requiredEvents": [],
        "recordedFields": [],
        "secretValueRecorded": false,
        "auditDestination": "none"
      },
      "approver": "synthetic-security-and-data-governance",
      "rejectionTrigger": "reject plaintext custody before any approval can authorize it",
      "approvalGate": {
        "id": "gate-plaintext-runtime",
        "status": "REJECTED_HARD",
        "requiredChecks": ["plaintext-custody-prohibited"],
        "evidence": "synthetic-hard-reject-plaintext-custody"
      },
      "decision": "REJECT_HARD"
    }
  ],
  "hardRejectConditions": [
    {
      "id": "literal-credential",
      "condition": "a literal credential value is supplied instead of a non-secret reference",
      "code": "KS91_SECRET_LITERAL_DENIED"
    },
    {
      "id": "literal-token",
      "condition": "a literal bearer or access token is supplied",
      "code": "KS91_SECRET_LITERAL_DENIED"
    },
    {
      "id": "literal-private-key",
      "condition": "a literal private key is supplied",
      "code": "KS91_SECRET_LITERAL_DENIED"
    },
    {
      "id": "secret-visible-to-log-or-artifact",
      "condition": "secret material is visible to a log, test output, artifact, fixture, telemetry stream, or review evidence",
      "code": "KS91_SECRET_LOG_ARTIFACT_DENIED"
    },
    {
      "id": "plaintext-custody",
      "condition": "custody stores, transports, or exposes plaintext secret material",
      "code": "KS91_PLAINTEXT_CUSTODY_DENIED"
    },
    {
      "id": "missing-approval-gate",
      "condition": "the option lacks a completed explicit approval gate before hypothetical access",
      "code": "KS91_APPROVAL_GATE_REQUIRED_DENIED"
    },
    {
      "id": "customer-credential-capture",
      "condition": "the option captures, requests, or persists a customer-supplied credential",
      "code": "KS91_CUSTOMER_CREDENTIAL_CAPTURE_DENIED"
    },
    {
      "id": "live-or-ambiguous-input",
      "condition": "input is live, non-synthetic, unknown, or ambiguous",
      "code": "KS91_LIVE_OR_AMBIGUOUS_INPUT_DENIED"
    }
  ],
  "negativeCases": [
    {
      "id": "reject-literal-credential",
      "expectedCode": "KS91_SECRET_LITERAL_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "literalKind": "credential"
      }
    },
    {
      "id": "reject-literal-token",
      "expectedCode": "KS91_SECRET_LITERAL_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "literalKind": "token"
      }
    },
    {
      "id": "reject-literal-private-key",
      "expectedCode": "KS91_SECRET_LITERAL_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "literalKind": "private-key"
      }
    },
    {
      "id": "reject-secret-visible-to-log",
      "expectedCode": "KS91_SECRET_LOG_ARTIFACT_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "exposureSurface": "logs"
      }
    },
    {
      "id": "reject-secret-visible-to-artifact",
      "expectedCode": "KS91_SECRET_LOG_ARTIFACT_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "exposureSurface": "artifacts"
      }
    },
    {
      "id": "reject-plaintext-custody",
      "expectedCode": "KS91_PLAINTEXT_CUSTODY_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "plaintext-runtime-custody",
        "custodyMode": "plaintext"
      }
    },
    {
      "id": "reject-missing-approval-gate",
      "expectedCode": "KS91_APPROVAL_GATE_REQUIRED_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "approvalGate": null
      }
    },
    {
      "id": "reject-customer-credential-capture",
      "expectedCode": "KS91_CUSTOMER_CREDENTIAL_CAPTURE_DENIED",
      "candidate": {
        "dataOrigin": "synthetic",
        "optionId": "reference-only-brokered-custody",
        "customerCredentialCapture": true
      }
    }
  ]
}
