  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "verdict": { "const": "GO" } },
            "required": ["verdict"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "citations": {
            "prefixItems": [
              {
                "properties": {
                  "status": { "const": "VERIFIED_LOCAL" },
                  "terminalDisposition": { "const": "VERIFIED_LOCAL" },
                  "contradictionStatus": { "const": "RESOLVED" }
                }
              },
              {
                "properties": {
                  "status": { "const": "VERIFIED_LOCAL" },
                  "terminalDisposition": { "const": "VERIFIED_LOCAL" },
                  "contradictionStatus": { "const": "RESOLVED" }
                }
              },
              {
                "properties": {
                  "status": { "const": "VERIFIED_LOCAL" },
                  "terminalDisposition": { "const": "VERIFIED_LOCAL" },
                  "contradictionStatus": { "const": "RESOLVED" }
                }
              },
              {
                "properties": {
                  "status": { "const": "VERIFIED_LOCAL" },
                  "terminalDisposition": { "const": "VERIFIED_LOCAL" },
                  "contradictionStatus": { "const": "RESOLVED" }
                }
              }
            ]
          },
          "assessments": {
            "properties": {
              "feasibility": { "properties": { "status": { "const": "PASS" } } },
              "risks": { "properties": { "status": { "const": "PASS" } } },
              "costs": { "properties": { "status": { "const": "PASS" } } },
              "complianceGaps": { "properties": { "status": { "const": "PASS" } } },
              "supportBurden": { "properties": { "status": { "const": "PASS" } } },
              "rollback": { "properties": { "status": { "const": "PASS" } } }
            }
          },
          "scopeEvaluation": {
            "prefixItems": [
              { "properties": { "status": { "const": "CLEAR" } } },
              { "properties": { "status": { "const": "CLEAR" } } },
              { "properties": { "status": { "const": "CLEAR" } } },
              { "properties": { "status": { "const": "CLEAR" } } }
            ]
          },
          "decision": {
            "properties": {
              "decisionRule": {
                "const": "ALL_REQUIRED_LOCAL_EVIDENCE_PASSES"
              },
              "goEvidenceSatisfied": { "const": true },
              "evidenceRefs": {
                "allOf": [
                  { "contains": { "pattern": "^FRC\\.0#" }, "minContains": 1 },
                  { "contains": { "pattern": "^FRC\\.1#" }, "minContains": 1 },
                  { "contains": { "pattern": "^FRC\\.2#" }, "minContains": 1 },
                  { "contains": { "pattern": "^FRC\\.3#" }, "minContains": 1 }
                ]
              }
            }
          },
          "reviewReceipt": {
            "properties": {
              "citationVerification": { "const": "PASS" },
              "referenceResolution": { "const": "PASS" },
              "assessmentEvaluation": { "const": "PASS" },
              "rejectRuleEvaluation": { "const": "CLEAR" }
            }
          }
        },
        "allOf": [
          { "$ref": "#/$defs/GoFeasibilityEvidence" },
          { "$ref": "#/$defs/GoRiskEvidence" },
          { "$ref": "#/$defs/GoCostEvidence" },
          { "$ref": "#/$defs/GoComplianceEvidence" },
          { "$ref": "#/$defs/GoSupportEvidence" },
          { "$ref": "#/$defs/GoRollbackEvidence" },
          { "$ref": "#/$defs/GoScopeBoundaryEvidence" }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "verdict": { "const": "NO-GO" } },
            "required": ["verdict"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "assessments": {
            "properties": {
              "feasibility": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } },
              "risks": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } },
              "costs": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } },
              "complianceGaps": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } },
              "supportBurden": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } },
              "rollback": { "properties": { "status": { "enum": ["PASS", "INCONCLUSIVE"] } } }
            }
          },
          "scopeEvaluation": {
            "items": {
              "properties": {
                "status": { "enum": ["CLEAR", "INCONCLUSIVE"] }
              }
            }
          },
          "decision": {
            "properties": {
              "decisionRule": {
                "const": "REQUIRED_LOCAL_EVIDENCE_INCOMPLETE_OR_INCONCLUSIVE"
              },
              "goEvidenceSatisfied": { "const": false }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "citations": {
                "contains": {
                  "properties": {
                    "status": { "enum": ["MISSING", "INVALID"] }
                  },
                  "required": ["status"]
                },
                "minContains": 1
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "feasibility": {
                    "properties": { "status": { "const": "INCONCLUSIVE" } }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "risks": {
                    "properties": { "status": { "const": "INCONCLUSIVE" } }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "costs": {
                    "properties": { "status": { "const": "INCONCLUSIVE" } }
                  }
                }
              }
            }
          },
          {
