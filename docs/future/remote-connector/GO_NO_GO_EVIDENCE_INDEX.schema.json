                  "rollback": {
                    "properties": { "status": { "const": "INCONCLUSIVE" } }
                  }
                }
              }
            }
          },
          {
            "properties": {
              "scopeEvaluation": {
                "contains": {
                  "properties": { "status": { "const": "INCONCLUSIVE" } },
                  "required": ["status"]
                },
                "minContains": 1
              }
            }
          },
          {
            "properties": {
              "reviewReceipt": {
                "properties": {
                  "citationVerification": { "const": "FAIL" }
                }
              }
            }
          },
          {
            "properties": {
              "reviewReceipt": {
                "properties": {
                  "referenceResolution": { "const": "FAIL" }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "properties": { "verdict": { "const": "REJECT" } },
            "required": ["verdict"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "decision": {
            "properties": {
              "decisionRule": {
                "const": "DECISIVE_EVIDENCE_FAILURE_OR_FORBIDDEN_SCOPE"
              },
              "goEvidenceSatisfied": { "const": false },
              "evidenceRefs": { "$ref": "#/$defs/NonEmptyEvidenceRefs" }
            }
          },
          "citations": {
            "contains": {
              "properties": {
                "claims": {
                  "contains": {
                    "properties": {
                      "claimClass": {
                        "enum": ["observed-fact", "computed-fact"]
                      },
                      "localVerification": { "const": "PASS" },
                      "decisionEffect": { "const": "SUPPORTS_REJECT" }
                    },
                    "required": [
                      "claimClass",
                      "localVerification",
                      "decisionEffect"
                    ]
                  },
                  "minContains": 1
                }
              },
              "required": ["claims"]
            },
            "minContains": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "assessments": {
                "properties": {
                  "feasibility": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "risks": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "costs": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "complianceGaps": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "supportBurden": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "assessments": {
                "properties": {
                  "rollback": { "properties": { "status": { "const": "FAIL" } } }
                }
              }
            }
          },
          {
            "properties": {
              "scopeEvaluation": {
                "contains": {
                  "properties": { "status": { "const": "VIOLATION" } },
