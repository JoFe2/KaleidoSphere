# Explicit optional offline SDK native-probe image; default service image unchanged.
# Build from repository root with exact built pan529 and pan526 contexts.
FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8
RUN apt-get update && apt-get install --no-install-recommends --yes git && rm -rf /var/lib/apt/lists/*
WORKDIR /app/services/bi-control
COPY services/bi-control/package.json services/bi-control/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --chown=10001:10001 services/bi-control/src ./src
COPY --chown=10001:10001 services/bi-control/query-packs ./query-packs
COPY --chown=10001:10001 services/bi-control/fixtures ./fixtures
COPY --chown=10001:10001 scripts/lib /app/scripts/lib
COPY --chown=10001:10001 contracts/dependencies /app/contracts/dependencies
COPY --chown=10001:10001 --from=pan529 / /opt/pan529
COPY --chown=10001:10001 --from=pan526 / /opt/pan526
RUN mkdir -p /opt/h05/tmp /opt/h05/state /opt/h05/owner && chown -R 10001:10001 /opt/h05 && chmod 0700 /opt/h05/tmp /opt/h05/state /opt/h05/owner
ENV TMPDIR=/opt/h05/tmp KS_H05_PAN_SOURCE_ROOT=/opt/pan529 KS292_PAN526_SOURCE=/opt/pan526 KS_H05_NATIVE_STATE_ROOT=/opt/h05/state
USER 10001:10001
CMD ["node", "src/server.mjs"]
