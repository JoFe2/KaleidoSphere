.env
.secrets/*
!.secrets/.gitkeep
.runtime/*
!.runtime/.gitkeep
# KS255 (KS-OPS-03) repository-owned runtime dependency root, installed by
# scripts/provision-ks255-journey-runtime.mjs --install. The installed artifact closure is
# never committed: only the pinned binding (dependencies/ks-journey-runtime/package.json +
# package-lock.json) and the artifact manifest (contracts/dependencies/) are tracked.
.ks-journey-runtime/
node_modules/
npm-debug.log*
*.tar
*.tgz
dist/

# KS238 pinned PAN producer artifact provision (verified by
# scripts/provision-ks238-order-source-dependency.mjs --verify). The pinned wrapper imports
# its compiled runtime from ../../dist, so the closure is re-included here explicitly rather
# than left to the global dist/ rule.
!dependencies/pansphaira/dist/
!dependencies/pansphaira/dist/**
