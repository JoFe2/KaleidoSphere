# Public localhost ports. Do not use the Owner gateway port 18789.
COMPOSE_PROJECT_NAME=chimpmaera-bi-m2
SUPERSET_PORT=18088
AGENT_PORT=18790
BI_UID=1000
BI_GID=1000

# M2 engine boundary. Choose exactly one of mssql|oracle|postgresql.
BI_ENGINE=mssql
# fixture is portable MSSQL; live executes only the selected engine's audited catalog pack.
BI_SOURCE_MODE=fixture
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=CM_BI_FIXTURE
MSSQL_USER=bi_readonly
MSSQL_SCHEMAS=dbo
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_QUERY_TIMEOUT_MS=10000

# Oracle runtime uses node-oracledb Thin mode: no Oracle Client libraries.
# ORACLE_DATABASE is DB_NAME; ORACLE_SERVICE_NAME is the exact PDB/service (CON_NAME).
# Use tcp only for a trusted local/test network. Use tcps for encrypted transport and
# set the certificate subject DN when your Oracle endpoint requires DN matching.
ORACLE_HOST=host.docker.internal
ORACLE_PORT=1521
ORACLE_DATABASE=FREE
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=BI_ANALYZE
ORACLE_SCHEMAS=BI_DEMO
ORACLE_PROTOCOL=tcp
ORACLE_TLS_SERVER_DN=
ORACLE_CONNECT_TIMEOUT_MS=10000
ORACLE_QUERY_TIMEOUT_MS=10000

# PostgreSQL runtime uses the pg driver with SCRAM-SHA-256. POSTGRESQL_SCHEMAS is an
# exact comma-separated scope. POSTGRESQL_STRUCTURE_QUERY_PACK selects the structure
# query pack: exact v1 (historical scan) or exact v2 (adds bounded index enumeration);
# any other value fails closed. v2 is the certified C1 structure scan.
POSTGRESQL_HOST=host.docker.internal
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=KS_BI_FIXTURE
POSTGRESQL_USER=bi_readonly
POSTGRESQL_SCHEMAS=public
# Loopback clean-room deployments use false; set true for TLS endpoints.
POSTGRESQL_SSL=false
POSTGRESQL_CONNECT_TIMEOUT_MS=10000
POSTGRESQL_QUERY_TIMEOUT_MS=10000
POSTGRESQL_STRUCTURE_QUERY_PACK=v2

# Optional OpenAI-compatible intent provider. `stub` is the deterministic offline E2E mode.
LLM_MODE=stub
LLM_BASE_URL=
LLM_MODEL=

# Runtime secrets are files under .secrets/ and .runtime/secrets/ (both gitignored).
# Put the selected source password only in the matching secret file:
# `.secrets/mssql_password`, `.secrets/oracle_password` or `.secrets/postgresql_password`,
# mode 0600. Never put credentials in `.env`, logs, command arguments, or commits.
# The optional provider key stays in `.secrets/llm_api_key`.
