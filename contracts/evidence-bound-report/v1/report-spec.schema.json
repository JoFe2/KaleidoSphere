{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/contracts/evidence-bound-report/v1/report-spec.schema.json",
  "title": "KaleidoSphere transport-neutral evidence-bound report specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reportId", "title", "dataset", "bindings"],
  "properties": {
    "schemaVersion": {"const": "kaleidosphere.reporting/evidence-bound-report-spec/v1"},
    "reportId": {"allOf": [{"$ref": "#/$defs/safeText"}, {"pattern": "^[a-z][a-z0-9._:-]{2,127}$"}]},
    "title": {"allOf": [{"$ref": "#/$defs/safeText"}, {"minLength": 1, "maxLength": 256}]},
    "dataset": {"$ref": "#/$defs/dataset"},
    "bindings": {"$ref": "#/$defs/bindings"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "datasetKind": {"enum": ["METRIC", "TABLE", "DIFFERENTIATOR_PLACEHOLDER"]},
    "dataType": {"enum": ["string", "integer", "number", "boolean"]},
    "cellDataType": {"$ref": "#/$defs/dataType"},
    "safeText": {"type": "string", "maxLength": 512, "pattern": "^(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:[Hh][Tt][Tt][Pp][Ss]?:\\/\\/|[Ff][Ii][Ll][Ee]:\\/\\/|[Jj][Aa][Vv][Aa][Ss][Cc][Rr][Ii][Pp][Tt]:|[Dd][Aa][Tt][Aa]:[Tt][Ee][Xx][Tt]|<\\/?[Ss][Cc][Rr][Ii][Pp][Tt]\\b|\\b(?:[Ee][Vv][Aa][Ll]|[Ff][Uu][Nn][Cc][Tt][Ii][Oo][Nn]|[Ss][Ee][Tt][Tt][Ii][Mm][Ee][Oo][Uu][Tt]|[Aa][Ll][Ee][Rr][Tt])\\s*\\(|=>|\\b(?:[Ss][Ee][Ll][Ee][Cc][Tt]|[Ii][Nn][Ss][Ee][Rr][Tt]|[Uu][Pp][Dd][Aa][Tt][Ee]|[Dd][Ee][Ll][Ee][Tt][Ee]|[Mm][Ee][Rr][Gg][Ee]|[Dd][Rr][Oo][Pp]|[Aa][Ll][Tt][Ee][Rr]|[Cc][Rr][Ee][Aa][Tt][Ee])\\b[\\s;]|(?:^|\\s)[=:][A-Za-z_$][\\w$]*(?:\\(|\\b)|(?:[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn])\\s*[:=]))"},
    "safeNumber": {
      "type": "number",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "x-kaleidosphere-invariants": {"finite": true, "negativeZero": false},
      "$comment": "The runtime additionally rejects negative zero with Object.is(value, -0); JSON Schema numbers do not preserve that distinction."
    },
    "nullableCell": {"type": "null"},
    "stringCell": {"allOf": [{"$ref": "#/$defs/safeText"}, {"maxLength": 512}]},
    "integerCell": {"allOf": [{"$ref": "#/$defs/safeNumber"}, {"type": "integer"}]},
    "numberCell": {"$ref": "#/$defs/safeNumber"},
    "booleanCell": {"type": "boolean"},
    "cell": {
      "oneOf": [
        {"$ref": "#/$defs/nullableCell"},
        {"$ref": "#/$defs/stringCell"},
        {"$ref": "#/$defs/booleanCell"},
        {"$ref": "#/$defs/numberCell"}
      ]
    },
    "row": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/cell"},
      "$comment": "The dataset column count is the row width; the runtime enforces equality and the typed/nullability relationship for each position."
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "dataType", "nullable"],
      "properties": {
        "key": {"allOf": [{"$ref": "#/$defs/safeText"}, {"pattern": "^[a-z][a-z0-9._:-]{2,127}$"}]},
        "label": {"allOf": [{"$ref": "#/$defs/safeText"}, {"minLength": 1, "maxLength": 128}]},
        "dataType": {"$ref": "#/$defs/dataType"},
        "nullable": {"type": "boolean"}
      }
    },
    "differentiator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status", "label"],
      "properties": {
        "type": {"const": "DIFFERENTIATOR_PLACEHOLDER"},
        "status": {"const": "UNPOPULATED"},
        "label": {"allOf": [{"$ref": "#/$defs/safeText"}, {"minLength": 1, "maxLength": 128}]}
      }
    },
    "dataset": {
      "type": "object",
      "x-kaleidosphere-invariants": {
        "rowWidth": {"path": "rows[*].length", "equals": "columns.length"},
        "columnKeys": {"path": "columns[*].key", "unique": true},
        "cellDataType": {"value": "rows[*][index]", "typeFrom": "columns[index].dataType"},
        "cellNullability": {"nullAllowedBy": "columns[index].nullable"},
        "numbers": {"finite": true, "absoluteMaximum": 9007199254740991, "negativeZero": false}
      },
      "additionalProperties": false,
      "required": ["schemaVersion", "datasetId", "kind", "columns", "rows", "differentiator"],
      "properties": {
        "schemaVersion": {"const": "kaleidosphere.reporting/evidence-bound-dataset/v1"},
        "datasetId": {"allOf": [{"$ref": "#/$defs/safeText"}, {"pattern": "^[a-z][a-z0-9._:-]{2,127}$"}]},
        "kind": {"$ref": "#/$defs/datasetKind"},
        "columns": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/column"},
          "$comment": "The runtime compares each column.key for uniqueness; uniqueItems also rejects duplicate column records at the schema layer."
        },
        "rows": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/row"}},
        "differentiator": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/differentiator"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "DIFFERENTIATOR_PLACEHOLDER"}}},
          "then": {
            "properties": {
              "columns": {"maxItems": 0},
              "rows": {"maxItems": 0},
              "differentiator": {"$ref": "#/$defs/differentiator"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "METRIC"}}},
          "then": {
            "properties": {
              "columns": {"minItems": 1, "maxItems": 1},
              "rows": {"minItems": 1, "maxItems": 1},
              "differentiator": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "TABLE"}}},
          "then": {
            "properties": {
              "columns": {"minItems": 1},
              "rows": {"minItems": 1},
              "differentiator": {"type": "null"}
            }
          }
        }
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotSha256", "receiptSha256", "coverageSha256", "capabilitySha256", "resultSha256"],
      "properties": {
        "snapshotSha256": {"$ref": "#/$defs/sha256"},
        "receiptSha256": {"$ref": "#/$defs/sha256"},
        "coverageSha256": {"$ref": "#/$defs/sha256"},
        "capabilitySha256": {"$ref": "#/$defs/sha256"},
        "resultSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
