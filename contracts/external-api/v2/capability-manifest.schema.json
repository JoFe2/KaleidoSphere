{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoFe2/KaleidoSphere/contracts/external-api/v2/capability-manifest.schema.json",
  "title": "KaleidoSphere external capability manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "manifestVersion", "product", "contract", "attestation", "capabilities", "consumerProfile", "boundaries", "integrity"],
  "properties": {
    "schemaVersion": {"const": "kaleidosphere.external/capability-manifest/v1"},
    "manifestVersion": {"const": "1.0.0"},
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "component"],
      "properties": {
        "id": {"const": "superset-bi-agent"},
        "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
        "component": {"const": "bi-agent-runtime"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "superset-bi-agent.external"},
        "version": {"const": "2.0.0"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "digest"],
      "properties": {
        "schemaVersion": {"const": "superset-bi-agent.external/capability-attestation/v2"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "executable", "authority", "sideEffect", "evidence"],
        "properties": {
          "id": {"enum": ["bi.status.read", "bi.discovery.run", "bi.analysis.run", "bi.graph.adaptive-v1.plan", "bi.preview.create", "bi.readback.read"]},
          "action": {"enum": ["status", "discovery", "analyze", "plan", "preview", "readback"]},
          "executable": {"const": true},
          "authority": {"enum": ["read-only", "local-evidence-write", "source-read-only", "proposal-only"]},
          "sideEffect": {"enum": ["none", "reversible-local-evidence"]},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["attestationBindingRequired", "resultIntegrityDigestRequired", "executionReceiptRequired"],
            "properties": {
              "attestationBindingRequired": {"const": true},
              "resultIntegrityDigestRequired": {"const": true},
              "executionReceiptRequired": {"const": true}
            }
          }
        }
      }
    },
    "consumerProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "product", "contract", "supported", "partial", "unsupported", "nonclaims", "boundaries", "attestation"],
      "properties": {
        "schemaVersion": {"const": "superset-bi-agent.external/consumer-profile/v1"},
        "product": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"const": "superset-bi-agent"},
            "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"}
          }
        },
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {"const": "superset-bi-agent.external"},
            "version": {"const": "2.0.0"}
          }
        },
        "supported": {
          "type": "array",
          "const": [
            {"id": "bi.status.read", "action": "status", "authority": "read-only"},
            {"id": "bi.discovery.run", "action": "discovery", "authority": "local-evidence-write"},
            {"id": "bi.analysis.run", "action": "analyze", "authority": "source-read-only"},
            {"id": "bi.graph.adaptive-v1.plan", "action": "plan", "authority": "proposal-only"},
            {"id": "bi.preview.create", "action": "preview", "authority": "proposal-only"},
            {"id": "bi.readback.read", "action": "readback", "authority": "read-only"}
          ]
        },
        "partial": {
          "type": "array",
          "const": [
            {"id": "superset.trusted-apply", "action": "trusted-apply", "authority": "trusted-approval-only", "externalIntent": false},
            {"id": "superset.trusted-readback", "action": "trusted-readback", "authority": "trusted-approval-only", "externalIntent": false},
            {"id": "superset.trusted-rollback", "action": "trusted-rollback", "authority": "trusted-approval-only", "externalIntent": false}
          ]
        },
        "unsupported": {
          "type": "array",
          "const": [
            {"surface": "sourceDatabaseCredentials", "accepted": false},
            {"surface": "freeSql", "accepted": false},
            {"surface": "rawSourceRows", "accepted": false},
            {"surface": "modelMutation", "accepted": false},
            {"surface": "directSupersetMutationIntent", "accepted": false}
          ]
        },
        "nonclaims": {
          "type": "array",
          "const": [
            {"id": "graph-candidate-promotion", "status": "none"},
            {"id": "persistent-superset-workflow", "status": "trusted-preview-approval-apply-readback-rollback-only"},
            {"id": "external-mutation-intent", "status": "none"}
          ]
        },
        "boundaries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceDatabaseCredentialsAccepted", "freeSqlAccepted", "rawSourceRowsReturned", "modelMutationAuthority", "directSupersetMutationIntentAccepted", "persistentSupersetWorkflow"],
          "properties": {
            "sourceDatabaseCredentialsAccepted": {"const": false},
            "freeSqlAccepted": {"const": false},
            "rawSourceRowsReturned": {"const": false},
            "modelMutationAuthority": {"const": false},
            "directSupersetMutationIntentAccepted": {"const": false},
            "persistentSupersetWorkflow": {"const": "trusted-preview-approval-apply-readback-rollback-only"}
          }
        },
        "attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "digest"],
          "properties": {
            "algorithm": {"const": "sha256-canonical-json"},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["externalIntentOnly", "sourceDatabaseCredentialsAccepted", "freeSqlAccepted", "rawSourceRowsReturned", "modelMutationAuthority", "directSupersetMutationIntentAccepted", "persistentSupersetWorkflow"],
      "properties": {
        "externalIntentOnly": {"const": true},
        "sourceDatabaseCredentialsAccepted": {"const": false},
        "freeSqlAccepted": {"const": false},
        "rawSourceRowsReturned": {"const": false},
        "modelMutationAuthority": {"const": false},
        "directSupersetMutationIntentAccepted": {"const": false},
        "persistentSupersetWorkflow": {"const": "trusted-preview-approval-apply-readback-rollback-only"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-json"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
